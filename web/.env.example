# Supabase (server-only client -- do not prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_or_service_role_key

# Stellar / Soroban (testnet)
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_REFERRAL_CONTRACT_ID=your_deployed_contract_id
NEXT_PUBLIC_COMMISSION_TOKEN_ID=your_usdc_or_token_contract_id
